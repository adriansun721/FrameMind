{
  "name": "framemind",
  "version": "0.1.0",
  "private": true,
  "description": "FrameMind - AI-assisted spatial frame analysis desktop application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:main && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/run-e2e-isolated.cjs",
    "evidence:t01": "npm run build && node scripts/capture-t01.cjs",
    "evidence:t02": "npm run build && node scripts/capture-t02.cjs",
    "evidence:t20:online": "npm run build && node scripts/verify-t20-online.cjs",
    "evidence:t21:online": "npm run build && node scripts/verify-t21-online.cjs",
    "evidence:t22:online": "npm run build && node scripts/verify-t22-online.cjs",
    "evidence:t23:online": "npm run build && node scripts/verify-t23-online.cjs",
    "evidence:t24:online": "npm run build && node scripts/verify-t24-online.cjs",
    "evidence:t25:online": "npm run build && node scripts/verify-t25-online.cjs",
    "evidence:t26:online": "npm run build && node scripts/verify-t26-online.cjs",
    "evidence:t31": "node scripts/verify-t31-numerics.mjs",
    "evidence:t32": "npm run build && node scripts/verify-t32-performance.cjs",
    "evidence:t33": "npm run build && node scripts/run-e2e-isolated.cjs e2e/t33-complete-demo.spec.ts",
    "evidence:t33:online": "npm run build && node scripts/verify-t33-online.cjs",
    "evidence:plan2:t211": "npm run build && node scripts/verify-plan2-t211.cjs",
    "evidence:plan2:t211:online": "npm run build && node scripts/verify-plan2-t211.cjs --online",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "package:win": "npm run build && node scripts/prepare-t34-delivery.cjs && electron-builder --win nsis --x64 --publish never",
    "evidence:t34": "node scripts/verify-t34-install.cjs",
    "evidence:t34:online": "node scripts/verify-t34-install.cjs --online",
    "delivery:t34": "node scripts/create-t34-delivery.cjs"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.2",
    "lucide-react": "latest",
    "pdf-lib": "^1.17.1",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron-builder": "26.17.0",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wait-on": "latest",
    "electron": "44.5.1",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1"
  }
}
