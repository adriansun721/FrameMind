{
  "name": "framemind",
  "version": "0.1.0",
  "private": true,
  "description": "FrameMind - AI-assisted spatial frame analysis desktop application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:main && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/run-e2e-isolated.cjs",
    "evidence:t01": "npm run build && node scripts/capture-t01.cjs",
    "evidence:t02": "npm run build && node scripts/capture-t02.cjs",
    "evidence:t20:online": "npm run build && node scripts/verify-t20-online.cjs",
    "evidence:t21:online": "npm run build && node scripts/verify-t21-online.cjs",
    "evidence:t22:online": "npm run build && node scripts/verify-t22-online.cjs",
    "evidence:t23:online": "npm run build && node scripts/verify-t23-online.cjs",
    "evidence:t24:online": "npm run build && node scripts/verify-t24-online.cjs",
    "evidence:t25:online": "npm run build && node scripts/verify-t25-online.cjs",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  }
}
